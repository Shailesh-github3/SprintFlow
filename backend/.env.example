# Copy to `.env` and fill in real values. Never commit `.env`.
# Every key below maps to ${...} placeholders in
# backend/src/main/resources/application.properties.

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sprintflow
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Auth (minimum 32 bytes — generate with: openssl rand -hex 32)
SPRINGFLOW_JWT_SECRET=change-me-to-a-64-hex-char-secret
SPRINGFLOW_JWT_EXPIRATION_MS=86400000

# CORS (comma-separated; must include the frontend origin when using cookies)
SPRINGFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend base URL used to build invitation links
SPRINGFLOW_FRONTEND_URL=http://localhost:5173

# Mail (Gmail app password, not your login password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Razorpay (test keys are fine for local dev; leave blank to skip)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
